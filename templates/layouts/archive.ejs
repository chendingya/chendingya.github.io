<div class="container">
  <main class="main-content">
    <div class="page-header">
      <h1 class="page-title">文章归档</h1>
      <p class="page-desc">按时间线浏览所有文章</p>
    </div>
    <div class="archive-list-wrap">
      <% const years = Object.keys(archive).sort((a, b) => b - a);
         years.forEach(year => { %>
        <section class="archive-year-section">
          <h2 class="archive-year"><%= year %></h2>
          <% const months = Object.keys(archive[year]).sort((a, b) => b - a);
             months.forEach(month => { %>
            <div class="archive-month-group">
              <h3 class="archive-month"><%= month %>月</h3>
              <ul class="archive-items">
                <% archive[year][month].forEach(item => { %>
                  <li class="archive-item">
                    <time class="archive-date"><%= new Date(item.date).getDate() %>日</time>
                    <span class="archive-title-wrap">
                      <a href="<%= item.url %>" class="archive-title"><%= item.title %></a>
                    </span>
                  </li>
                <% }); %>
              </ul>
            </div>
          <% }); %>
        </section>
      <% }); %>
      <% if (years.length === 0) { %>
        <div class="empty-state">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <p>暂无文章</p>
        </div>
      <% } %>
    </div>
  </main>
</div>
