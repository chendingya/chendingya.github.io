<div class="container">
  <main class="main-content">
    <article class="page-content">
      <div class="page-header">
        <h1 class="page-title"><%= page.title || title %></h1>
        <% if (page.description) { %>
          <p class="page-desc"><%= page.description %></p>
        <% } %>
      </div>
      <div class="post-body">
        <%- content %>
      </div>
    </article>
  </main>
</div>
