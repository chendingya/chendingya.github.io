<section class="gbook-hero">
  <h1>留言</h1>
  <p class="gbook-subtitle">访客留言</p>
</section>

<!-- 编辑器（默认折叠） -->
<div class="gbook-editor-wrap" id="gbookEditorWrap">
  <div class="gbook-setup" id="gbookSetup">
    <h2>身份验证</h2>
    <p>需要 GitHub Token 和 Gist ID</p>
    <label>
      GitHub Token
      <input type="password" id="githubToken" placeholder="ghp_xxxxxxxxxxxxxxxxxxxx" autocomplete="off" spellcheck="false">
      <small>需要 <code>gist</code> 权限 · <a href="https://github.com/settings/tokens/new?scopes=gist&description=gbook" target="_blank" rel="noopener">点此创建</a></small>
    </label>
    <label>
      Gist ID（留空自动创建）
      <input type="text" id="gistId" placeholder="abc123def456..." autocomplete="off" spellcheck="false">
    </label>
    <button class="gbook-btn gbook-btn--primary" id="saveConfig">确认</button>
  </div>

  <div class="gbook-editor hidden" id="gbookEditor">
    <div class="gbook-editor__toolbar">
      <input type="text" id="noteTitle" placeholder="昵称" class="gbook-input">
      <div class="gbook-editor__actions">
        <button class="gbook-btn" id="saveDraft">存草稿</button>
        <button class="gbook-btn gbook-btn--primary" id="publishNote">提交 ▼</button>
      </div>
    </div>
    <div class="gbook-editor__pane">
      <textarea id="noteEditor" class="gbook-textarea" placeholder="写点什么...支持 Markdown 语法"></textarea>
      <div class="gbook-preview" id="notePreview"></div>
    </div>
    <div class="gbook-editor__bottom">
      <span class="gbook-status" id="syncStatus"></span>
      <label class="gbook-visibility">
        <input type="checkbox" id="isSecret" checked> 仅链接可见
      </label>
    </div>
  </div>

  <div class="gbook-drafts hidden" id="gbookDrafts">
    <h3>草稿箱</h3>
    <div id="draftList"></div>
  </div>
</div>

<section class="gbook-content">
  <% const noteData = dataSources['comments']; %>
  <% if (noteData && noteData.error) { %>
    <div class="gbook-empty">
      <p>暂无留言</p>
      <p class="gbook-hint">在 <code>config/default.yml</code> 中配置 <code>plugins.config.comments.gistId</code></p>
    </div>
  <% } else if (noteData && noteData.notes && noteData.notes.length > 0) { %>
    <div class="gbook-meta">
      共 <%= noteData.notes.length %> 条
      <% if (noteData.updated) { %>
        · 最近 <%= new Date(noteData.updated).toLocaleString('zh-CN') %>
      <% } %>
    </div>

    <div class="gbook-list">
    <% noteData.notes.forEach(function(note) { %>
      <article class="gbook-card">
        <div class="gbook-card__header">
          <h2><%= note.name.replace(/\.md$/i, '') %></h2>
        </div>
        <div class="gbook-card__body"><%- note.content %></div>
      </article>
    <% }) %>
    </div>
  <% } else { %>
    <div class="gbook-empty"><p>还没有留言</p></div>
  <% } %>
</section>

<p class="gbook-footer-link"><a href="#" id="toggleEditor">收起 ▲</a></p>
