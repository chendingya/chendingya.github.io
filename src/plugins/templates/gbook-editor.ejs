<section class="gbook-hero">
  <h1>留言板</h1>
  <p class="gbook-subtitle">留下你的想法</p>
</section>

<section class="gbook-content">
  <!-- 首次配置 -->
  <div class="gbook-setup" id="gbookSetup">
    <h2>身份验证</h2>
    <p>需要 GitHub Token 和 Gist ID 才能使用留言功能</p>

    <label>
      GitHub Token
      <input type="password" id="githubToken" placeholder="ghp_xxxxxxxxxxxxxxxxxxxx"
        autocomplete="off" spellcheck="false">
      <small>需要 <code>gist</code> 权限 · <a href="https://github.com/settings/tokens/new?scopes=gist&description=gbook" target="_blank" rel="noopener">点此创建</a></small>
    </label>

    <label>
      Gist ID（留空自动创建）
      <input type="text" id="gistId" placeholder="abc123def456..." autocomplete="off" spellcheck="false">
      <small>已有则填入，没有就留空自动创建</small>
    </label>

    <button class="gbook-btn gbook-btn--primary" id="saveConfig">确认</button>
  </div>

  <!-- 编辑器 -->
  <div class="gbook-editor hidden" id="gbookEditor">
    <div class="gbook-editor__toolbar">
      <input type="text" id="noteTitle" placeholder="昵称" class="gbook-input">
      <div class="gbook-editor__actions">
        <button class="gbook-btn" id="saveDraft">存草稿</button>
        <button class="gbook-btn gbook-btn--primary" id="publishNote">提交 ▼</button>
      </div>
    </div>

    <div class="gbook-editor__pane">
      <textarea id="noteEditor" class="gbook-textarea" placeholder="写点什么...

支持 Markdown 语法"></textarea>
      <div class="gbook-preview" id="notePreview"></div>
    </div>

    <div class="gbook-editor__bottom">
      <span class="gbook-status" id="syncStatus"></span>
      <label class="gbook-visibility">
        <input type="checkbox" id="isSecret" checked> 仅链接可见
      </label>
    </div>
  </div>

  <!-- 草稿 -->
  <div class="gbook-drafts hidden" id="gbookDrafts">
    <h3>草稿箱</h3>
    <div id="draftList"></div>
  </div>
</section>
